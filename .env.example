WORKSPACE_STORAGE_BACKEND=local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
AZURE_TABLES_ENDPOINT=
SESSION_STORE_BACKEND=local

# Claude SDK transcript persistence
CLAUDE_TRANSCRIPT_STORE_BACKEND=local
CLAUDE_TRANSCRIPT_CONTAINER=


# Execution provider
EXECUTION_PROVIDER=local_docker

# Local Docker capacity
LOCAL_MAX_SESSIONS=10
LOCAL_HOST_MEMORY_MB=4096

# Azure Container Apps Sandboxes
AZURE_SUBSCRIPTION_ID=
# Optional fallback when all sandbox groups share one resource group.
AZURE_SANDBOX_RESOURCE_GROUP=
# Format: group-name:resource-group,another-group:another-resource-group
AZURE_SANDBOX_GROUPS=
# Sandbox endpoint supplied for your Azure sandbox environment.
AZURE_SANDBOX_ENDPOINT=
AZURE_SANDBOX_CPU=2000m
AZURE_SANDBOX_MEMORY=6144Mi
AZURE_SANDBOX_DISK_SIZE=
AZURE_SANDBOX_AUTO_SUSPEND_SECONDS=300

# Per-session execution limits
SESSION_MEMORY_MB=6144
SESSION_MAX_MEMORY_MB=8192
SESSION_MAX_CONCURRENT=50
